# Copy this file to server.env and edit only the values that differ on the target server.

# Python environment created by install_server.sh.
PI05_PYTHON=.venv-pi05/bin/python

# This must be a prepared pretrained_model_serve_nocompile directory.
PI05_MODEL_PATH=/data/models/pi05-folding/pretrained_model_serve_nocompile

# CUDA_VISIBLE_DEVICES value. A single PI05 server uses one GPU.
PI05_GPU=0
PI05_HOST=0.0.0.0
PI05_PORT=8005
PI05_TASK="Fold the black short-sleeve shirt."

# Keep model/tokenizer downloads disabled after all assets are present locally.
PI05_HF_OFFLINE=1
